// Kimi K3 (kimi_k3), shapes read from the released model's own config.json.
// Form: llvm.func + hacc.entry + __tile_* -- the shape the emitters consume.
module {
  llvm.func @k3_embedding_7168(%arg0: !llvm.ptr<1>, %arg1: !llvm.ptr<1>, %arg2: !llvm.ptr<1>) attributes {hacc.entry} {
    %z = llvm.mlir.constant(0 : i32) : i32
    %v = llvm.mlir.constant(163840 : i32) : i32
    %d = llvm.mlir.constant(7168 : i32) : i32
    %n = llvm.mlir.constant(1 : i32) : i32
    %w = llvm.call @__tile_load_f32(%arg0, %n, %d) : (!llvm.ptr<1>, i32, i32) -> i32
    %o = llvm.call @__tile_embedding_f32(%z, %w, %arg1, %v, %d, %n) : (i32, i32, !llvm.ptr<1>, i32, i32, i32) -> i32
    llvm.call @__tile_store_f32(%arg2, %o, %n, %d) : (!llvm.ptr<1>, i32, i32, i32) -> ()
    llvm.return
  }
}
