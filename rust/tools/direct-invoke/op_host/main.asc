#include <cstdlib>
#include <cstdio>
#include <string>
// Direct-invoke host entry for one emitted AscendC kernel.
//
// This is the CANN `ASC` language path: one translation unit holds the kernel
// and the host, and the language driver supplies the launch shim. The kernel
// file is copied in as `op_kernel/vec_add_kernel.asc` by `setup.sh` -- it is
// emitter output, never edited.
//
// Everything kernel-specific arrives as a macro from the build: the launcher
// symbol, the extent, the arity, the oracle and its constants. A harness that
// hard-coded any of them would measure one kernel and claim a column.
#include <acl/acl.h>

#include <cmath>
#include <cstdio>
#include <vector>

#ifndef KERNEL_DO
#define KERNEL_DO vec_add_do
#endif
#ifndef KERNEL_N
#define KERNEL_N 256
#endif
// The streaming-matvec oracle's own extents. Defaults match the probe kernel; a
// different shape needs them passed as -DMV_N/-DMV_K, which is deliberate -- an
// oracle that inferred them from `n` would be guessing at the kernel's shape.
#ifndef MV_N
#define MV_N 64
#endif
#ifndef MV_K
#define MV_K 256
#endif

#ifndef KERNEL_REPEAT
// 1 = no timing at all (the historical behaviour, and the default so that a plain
// correctness run pays nothing). Above 1 the launch is repeated and the FIRST is
// discarded: it pays for first-touch of GM and of the UB the allocator carved.
#define KERNEL_REPEAT 1
#endif

#ifndef KERNEL_ARGS
#define KERNEL_ARGS 3
#endif
#ifndef ORACLE
#define ORACLE 0  // 0 = a + b, 1 = rmsnorm, 2 = dot(a,b) into element 0, 3 = silu(a)*b
#endif
#ifndef RMS_EPS
#define RMS_EPS 1e-5f
#endif
#ifndef TOLERANCE
#define TOLERANCE 1e-6
#endif

#include "vec_add_kernel.asc"

#define CHECK(expr)                                                            \
    do {                                                                       \
        auto __r = (expr);                                                     \
        if (__r != ACL_SUCCESS) {                                              \
            printf("FAIL %s -> %d\n", #expr, (int)__r);                        \
            return 1;                                                          \
        }                                                                      \
    } while (0)

int main() {
    const int n = KERNEL_N;

    CHECK(aclInit(nullptr));
    CHECK(aclrtSetDevice(0));
    aclrtContext ctx = nullptr;
    CHECK(aclrtCreateContext(&ctx, 0));
    aclrtStream stream = nullptr;
    CHECK(aclrtCreateStream(&stream));

    const size_t bytes = static_cast<size_t>(n) * sizeof(float);
    void *p0 = nullptr;
    void *p1 = nullptr;
    void *p2 = nullptr;
    void *p3 = nullptr;
    void *p4 = nullptr;
    void *p5 = nullptr;
    void *p6 = nullptr;
    void *p7 = nullptr;
    void *p8 = nullptr;
    CHECK(aclrtMalloc(&p0, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p1, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p2, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#if KERNEL_ARGS >= 4
    CHECK(aclrtMalloc(&p3, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
#if KERNEL_ARGS == 5
    CHECK(aclrtMalloc(&p4, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
#if KERNEL_ARGS == 9
    // eight inputs + one output: p3 already allocated above, p4..p8 here.
    CHECK(aclrtMalloc(&p4, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p5, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p6, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p7, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK(aclrtMalloc(&p8, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
#endif
    uint8_t *gm0 = static_cast<uint8_t *>(p0);
    uint8_t *gm1 = static_cast<uint8_t *>(p1);
    uint8_t *gm2 = static_cast<uint8_t *>(p2);

    std::vector<float> a(n), b(n, 0.0f), c(n, 0.0f), v(n, 0.0f), s(n, 0.0f);
    std::vector<float> e(n, 0.0f), f(n, 0.0f), g(n, 0.0f), h(n, 0.0f);
    // Values chosen so a row statistic is neither 0 nor 1 and the sign is
    // mixed: an all-positive input hides a sign error in a normalisation.
    for (int i = 0; i < n; ++i) {
        a[i] = static_cast<float>(i) * 0.5f - 3.25f;
        b[i] = static_cast<float>(n - i) * 1.75f + 0.125f;
        if (ORACLE == 10) {
            // SiTU's tanh identity `(e^{2z}-1)/(e^{2z}+1)` OVERFLOWS in f32 past
            // |z| ~ 44, i.e. |g| >~ 176 or |u| >~ 1100. The generator's own domain
            // is activations, |g|,|u| <~ 10, so feeding the default ramp (up to
            // 5376) tests OUTSIDE the function's valid domain and reports the
            // overflow rather than the arithmetic. These inputs stay inside it;
            // the limit itself is recorded in the manifests, not hidden here.
            a[i] = (static_cast<float>(i % 37) - 18.0f) * 0.25f;
            b[i] = (static_cast<float>(i % 29) - 14.0f) * 0.5f;
        }
        v[i] = static_cast<float>(i % 7) * 0.25f - 0.5f;
        if (ORACLE == 180) {
  // DEAD: init section, runs before the launch; the live block is after the copy-back.
        // BROADCAST: out[r][c] = a[c], the `col_expand` primitive the engine's flash attention
        // opens with. MV_N is the row count, MV_K the row width.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        // `col`, not `c`: `c` is the OUTPUT VECTOR in this harness, and shadowing it made
        // `c[r * MV_K + col]` subscript an integer. The compiler caught it; the naming is what
        // invited it.
        for (int r = 0; r < MV_N; ++r) {
            for (int col = 0; col < MV_K; ++col) {
                const double want = static_cast<double>(a[col]);
                const double got = static_cast<double>(c[r * MV_K + col]);
                const double d = std::fabs(got - want);
                abs_sum += d;
                sum_ref += std::fabs(want);
                if (d > max_abs) max_abs = d;
            }
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_N * MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
    if (ORACLE >= 23 && ORACLE <= 30) {
        // Attention inputs are BOUNDED. The default ramp reaches ~1.2e5 across 70,000 elements, so a
        // 64-term dot overflows f32 to inf and `inf - inf` is NaN -- which reads exactly like a
        // broken softmax. An earlier attempt at this block was inserted with the wrong indentation
        // and landed NESTED inside another oracle's body, so it never ran and three rounds of
        // attention bisect used the ramp regardless.
        a[i] = 0.002f * static_cast<float>((i % 7) - 3);
        b[i] = 0.002f * static_cast<float>((i % 11) - 5);
        v[i] = 0.01f * static_cast<float>((i % 5) - 2);
    }
    if (ORACLE == 17) {
            // q8mv: `a` holds int8 weight BYTES and `b` the scale plane. The default ramps give a
            // scale of ~1e7 and byte values of arbitrary garbage, so the dot overflows f32 and the
            // comparison reports chaos rather than arithmetic. Real blocks are ~1e-3.
            // NON-CANCELLING on purpose: with mixed signs the terms sum to ~0, sum|want| collapses,
            // and a backward-error ratio reports 974 on a kernel whose max_abs is 2e-08. The metric
            // needs a denominator that is not the residue of a cancellation.
            reinterpret_cast<signed char *>(a.data())[i] = static_cast<signed char>((i % 17) + 1);
            b[i] = 0.001f;
            v[i] = 1.0f;
        }
        if (ORACLE == 15 && i == 0) {
            // ONCE, not per element. This block packs MV_N*MV_K weights; inside the
            // `for (i < n)` loop it was executed n = 1.2e6 times, i.e. 5e12 inner
            // iterations, and the harness spun at 100% CPU for 25 minutes while I
            // blamed the device kernel -- which had in fact run in 0.077 ms.
            // w8a8: `b` is the int8 weight row (raw bytes), `v` the per-channel scale,
            // `s` the per-channel offset. Deterministic and inside int8 range.
            signed char *wq = reinterpret_cast<signed char *>(b.data());
            for (int r = 0; r < MV_N; ++r) {
                for (int k = 0; k < MV_K; ++k)
                    wq[r * MV_K + k] = static_cast<signed char>(((r * 7 + k * 13) % 255) - 127);
                v[r] = 0.5f / static_cast<float>((r % 7) + 1);
                // Arity 5 binds the fourth input to `s`, not `e`: the harness picks the
                // buffer by ARITY, and this kernel is x, w, scale, offset -> out.
                s[r] = static_cast<float>((r % 5) - 2);
            }
        }
        if (ORACLE == 14) {
            // q8_0 weights packed into `b` as RAW BYTES: per 32 elements a 2-byte half
            // scale (0x3800 = 0.5) then 32 signed int8. `b` holds n floats = 4n bytes,
            // and the probe needs MV_N * (MV_K / 32) * 34 of them.
            unsigned char *bytes = reinterpret_cast<unsigned char *>(b.data());
            for (int r = 0; r < MV_N; ++r) {
                for (int blk = 0; blk < MV_K / 32; ++blk) {
                    unsigned char *p = bytes + ((size_t)r * (MV_K / 32) + blk) * 34;
                    p[0] = 0x00;
                    p[1] = 0x38;  // little-endian f16 0.5
                    for (int q = 0; q < 32; ++q)
                        p[2 + q] = static_cast<unsigned char>(
                            static_cast<signed char>(((r + blk + q) % 17) - 8));
                }
            }
        }
        if (ORACLE == 12) {
            // rope halves: b is cos and v is sin, so they must stay in [-1, 1].
            // The default ramps reach ~1e2, which is outside any angle's cosine and
            // would test the oracle rather than the kernel.
            b[i] = static_cast<float>(cos(0.1 * i));
            v[i] = static_cast<float>(sin(0.1 * i));
        }
        if (ORACLE == 8) {
            // The fused gate/up is silu(x*wg)*(x*wu). At n = 16384 the default
            // ramp reaches |x*wg| ~ 1e6, where silu is no longer an activation and
            // the f64 oracle leaves the f32 range -- the same domain mistake the
            // SiTU oracle made, at a different oracle. Keep the operands inside
            // the function's domain and say so here.
            a[i] = (static_cast<float>(i % 37) - 18.0f) * 0.125f;
            b[i] = (static_cast<float>(i % 29) - 14.0f) * 0.25f;
            v[i] = (static_cast<float>(i % 23) - 11.0f) * 0.5f;
        }
        e[i] = static_cast<float>(i % 11) * 0.5f - 2.5f;
        f[i] = static_cast<float>(i % 13) * 0.25f - 1.5f;
        g[i] = static_cast<float>(i % 17) * 0.125f - 1.0f;
        h[i] = static_cast<float>(i % 19) * 0.0625f - 0.5f;
        s[i] = static_cast<float>(i % 5) * 0.75f + 0.125f;
    }
    // REAL INPUTS FROM DISK, when DS4_IN_DIR is set: a.bin/b.bin/v.bin/s.bin each hold `n`
    // floats. This is what lets the harness verify a CERTIFIED kernel against real model
    // bytes rather than synthetic ones -- the gap between "the kernel matches its oracle on
    // made-up data" and "the kernel matches the host on the deployment package".
    if (const char *in_dir = std::getenv("DS4_IN_DIR")) {
        auto slurp = [&](const char *name, std::vector<float> &dst) {
            std::string p = std::string(in_dir) + "/" + name;
            FILE *fp = std::fopen(p.c_str(), "rb");
            if (!fp) return false;
            const size_t got = std::fread(dst.data(), sizeof(float), dst.size(), fp);
            std::fclose(fp);
            return got == dst.size();
        };
        bool ok = true;
        ok &= slurp("a.bin", a);
#if KERNEL_ARGS != 2
        ok &= slurp("b.bin", b);
#endif
#if KERNEL_ARGS >= 4
        ok &= slurp("v.bin", v);
#endif
#if KERNEL_ARGS == 5
        ok &= slurp("s.bin", s);
#endif
        if (!ok) {
            std::fprintf(stderr, "DS4_IN_DIR=%s: an input file is missing or the wrong size\n", in_dir);
        }
    }

    CHECK(aclrtMemcpy(gm0, bytes, a.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#if KERNEL_ARGS != 2
    // ANY arity above 2 has a second input. This guard used to read `== 3`, so a
    // FIVE-argument kernel ran with `k` never copied: `q.k` was zero, the whole
    // beta*(q.k)*v term vanished, and the kernel was blamed for a harness bug.
    // The symptom was exact -- got == 0.5*s to the last digit -- which is what
    // sent the search into the emitter when the fault was here.
    CHECK(aclrtMemcpy(gm1, bytes, b.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
    // EVERY input the arity declares, selected by the ARITY rather than by a
    // remembered case. This file has now had the same bug twice -- `b` copied
    // only for ARGS==3 (so a five-argument kernel ran with k = 0 and a whole
    // term vanished) and `v` copied only for ARGS==5 (so a four-argument kernel
    // ran with wu = 0). Each produced a convincing "the emitter drops a term"
    // symptom. The arity is the only fact this file should branch on.
#if KERNEL_ARGS >= 4
    CHECK(aclrtMemcpy(gm2, bytes, v.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
#if KERNEL_ARGS == 5
    CHECK(aclrtMemcpy(p3, bytes, s.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif
#if KERNEL_ARGS == 9
    // x0=a, x1=b (gm0/gm1), x2=v (gm2), x3=e (p3); w0..w3 = f,g,h,s (p4..p7).
    //
    // p3 is filled HERE and not by the `== 5` branch above, which is the branch
    // that fills p3 for a five-argument kernel. Missing this left x3 as freshly
    // allocated zeros, and the diagnostic was beautiful: the output was short by
    // exactly one product, -0.3125 = x3*w3 with x3 = 0.
    CHECK(aclrtMemcpy(p3, bytes, e.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p4, bytes, f.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p5, bytes, g.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p6, bytes, h.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK(aclrtMemcpy(p7, bytes, s.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
#endif

    // The arity is a property of the kernel's signature, so it has to be a
    // preprocessor split: a runtime `if` compiles both calls and the wrong-arity
    // one does not resolve.
#if KERNEL_ARGS == 9
    // eight inputs then the output: (x0..x3, w0..w3) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
              static_cast<uint8_t *>(p4), static_cast<uint8_t *>(p5),
              static_cast<uint8_t *>(p6), static_cast<uint8_t *>(p7),
              static_cast<uint8_t *>(p8));
#elif KERNEL_ARGS == 4
    // three inputs then the output: (x, wg, wu) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3));
#elif KERNEL_ARGS == 5
    // 4 inputs then the output: (q, k, v, s) -> o
    KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
              static_cast<uint8_t *>(p4));
#elif KERNEL_ARGS == 3
    KERNEL_DO(1, stream, gm0, gm1, gm2);
#else
    KERNEL_DO(1, stream, gm0, gm1);  // two-argument: (in, out)
#endif
    CHECK(aclrtSynchronizeStream(stream));

    // TIMING. The harness used to report correctness only -- no clock, no event, no
    // duration anywhere -- so no question of the form "is this emission faster" could be
    // answered with it. One event pair around the launch that already exists, plus a
    // repeat so a single launch's noise cannot pass for a result.
    //
    // The first launch is excluded from the average: it pays for the kernel's own
    // first-touch of GM and of the UB the allocator carved, and including it made short
    // kernels look 3x slower than they are on the box this was first measured on.
#if KERNEL_REPEAT > 1
    {
      aclrtEvent ev_start = nullptr, ev_end = nullptr;
      CHECK(aclrtCreateEvent(&ev_start));
      CHECK(aclrtCreateEvent(&ev_end));
      double total_ms = 0.0;
      for (int rep = 0; rep < KERNEL_REPEAT; ++rep) {
#if KERNEL_ARGS == 9
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
                  static_cast<uint8_t *>(p4), static_cast<uint8_t *>(p5),
                  static_cast<uint8_t *>(p6), static_cast<uint8_t *>(p7),
                  static_cast<uint8_t *>(p8));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 4
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 5
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2, static_cast<uint8_t *>(p3),
                  static_cast<uint8_t *>(p4));
        CHECK(aclrtRecordEvent(ev_end, stream));
#elif KERNEL_ARGS == 3
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1, gm2);
        CHECK(aclrtRecordEvent(ev_end, stream));
#else
        CHECK(aclrtRecordEvent(ev_start, stream));
        KERNEL_DO(1, stream, gm0, gm1);
        CHECK(aclrtRecordEvent(ev_end, stream));
#endif
        CHECK(aclrtSynchronizeStream(stream));
        if (rep > 0) {
          float ms = 0.0f;
          CHECK(aclrtEventElapsedTime(&ms, ev_start, ev_end));
          total_ms += ms;
        }
      }
      printf("TIME_MS %.6f\n", total_ms / static_cast<double>(KERNEL_REPEAT - 1));
      CHECK(aclrtDestroyEvent(ev_start));
      CHECK(aclrtDestroyEvent(ev_end));
    }
#endif
#if KERNEL_ARGS == 9
    CHECK(aclrtMemcpy(c.data(), bytes, p8, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 4
    CHECK(aclrtMemcpy(c.data(), bytes, p3, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 5
    CHECK(aclrtMemcpy(c.data(), bytes, p4, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#elif KERNEL_ARGS == 3
    CHECK(aclrtMemcpy(c.data(), bytes, gm2, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#else
    CHECK(aclrtMemcpy(c.data(), bytes, gm1, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
#endif

    // ORACLE 1: y = x / sqrt(mean(x^2) + eps), the definition the emitted
    // kernel implements. Accumulated in f64 so the comparison is against the
    // real-valued answer rounded once, not against a second f32 accumulation.
    double mean_sq = 0.0;
    for (int i = 0; i < n; ++i) {
        mean_sq += static_cast<double>(a[i]) * static_cast<double>(a[i]);
    }
    mean_sq /= n;
    const double rms_denom = std::sqrt(mean_sq + static_cast<double>(RMS_EPS));

    double max_abs = 0.0, max_rel = 0.0;
    int wrong = 0;
    if (ORACLE == 10) {
        // SiTU, from the generator's own definition:
        //   situ(g,u) = b*tanh(g/b)*sigmoid(g) * b_lin*tanh(u/b_lin)
        // with the K3 config's betas (4.0 and 25.0), which the kernel folds in.
        const double beta = 4.0, beta_lin = 25.0;
        for (int i = 0; i < n; ++i) {
            const double g = static_cast<double>(a[i]);
            const double u = static_cast<double>(b[i]);
            const double want = beta * std::tanh(g / beta) * (1.0 / (1.0 + std::exp(-g)))
                              * (beta_lin * std::tanh(u / beta_lin));
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        // WHERE, not just how many. A count cannot distinguish "half the output is
        // unwritten" from "every chunk computed the wrong thing", and those have
        // different causes. First and last mismatch, with the values.
        {
            int first = -1, last = -1;
            for (int i = 0; i < n; ++i) {
                const double gv = static_cast<double>(a[i]);
                const double uv = static_cast<double>(b[i]);
                const double want = 4.0 * std::tanh(gv / 4.0) * (1.0 / (1.0 + std::exp(-gv)))
                                  * (25.0 * std::tanh(uv / 25.0));
                const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
                if (std::fabs(static_cast<double>(c[i]) - want) / ref > TOLERANCE) {
                    if (first < 0) first = i;
                    last = i;
                }
            }
            if (first >= 0) {
                printf("first mismatch at %d: got %0.6e want %0.6e\n", first,
                       static_cast<double>(c[first]),
                       4.0 * std::tanh(static_cast<double>(a[first]) / 4.0)
                           * (1.0 / (1.0 + std::exp(-static_cast<double>(a[first]))))
                           * (25.0 * std::tanh(static_cast<double>(b[first]) / 25.0)));
                printf("last mismatch at %d of %d\n", last, n);
            }
        }
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 8) {
        // The fused gate/up: g = x*wg, u = x*wu, out = silu(g) * u.
        for (int i = 0; i < n; ++i) {
            const double g = static_cast<double>(a[i]) * static_cast<double>(b[i]);
            const double u = static_cast<double>(a[i]) * static_cast<double>(v[i]);
            const double want = (g / (1.0 + std::exp(-g))) * u;
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 7) {
        // sum(a[i]*b[i]) broadcast: the delta-net's dot product, two distinct loads.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]) * static_cast<double>(b[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 6) {
        // sum(a[i]^2) broadcast: the same primitive with a COMPUTED source,
        // which is the shape the delta-net's reduce takes.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]) * static_cast<double>(a[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 9) {
        // DUMP: print the inputs, the scalar the kernel should broadcast, and the
        // first outputs. One run, and the arithmetic decides which term is wrong
        // -- cheaper than three probe kernels and no less conclusive.
        double qk = 0.0;
        for (int j = 0; j < n; ++j) qk += static_cast<double>(a[j]) * static_cast<double>(b[j]);
        printf("q=%0.6e %0.6e  k=%0.6e %0.6e  v=%0.6e %0.6e  s=%0.6e %0.6e\n",
               a[0], a[1], b[0], b[1], v[0], v[1], s[0], s[1]);
        printf("qk=%0.9e   (0.5*s + qk*v)[0]=%0.9e  got[0]=%0.9e\n",
               qk, 0.5 * static_cast<double>(s[0]) + qk * static_cast<double>(v[0]),
               static_cast<double>(c[0]));
        printf("(0.5*s)[0]=%0.9e  (qk*v)[0]=%0.9e  got[1]=%0.9e  s-only? %s\n",
               0.5 * static_cast<double>(s[1]), qk * static_cast<double>(v[1]),
               static_cast<double>(c[1]),
               std::fabs(c[1] - 0.5 * static_cast<double>(s[1])) < 1e-6 ? "yes" : "no");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3); aclrtFree(p4);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return 0;
    }
    if (ORACLE == 5) {
        // sum(a) broadcast over the row: isolates reduce_sum + row_expand.
        double sum = 0.0;
        for (int i = 0; i < n; ++i) sum += static_cast<double>(a[i]);
        for (int i = 0; i < n; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - sum);
            if (d > max_abs) max_abs = d;
            const double ref = std::fabs(sum) > 1e-12 ? std::fabs(sum) : 1.0;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (const char *ref_file = std::getenv("DS4_REF_FILE")) {
        // Expected output from the HOST reference (f64 dequantisation of the same bytes), so
        // this compares an independent implementation against the device kernel -- the check
        // that matters when the inputs are REAL model tensors rather than synthetic ones.
        std::vector<float> want(n, 0.0f);
        FILE *fp = std::fopen(ref_file, "rb");
        if (!fp) {
            std::fprintf(stderr, "DS4_REF_FILE=%s: cannot open\n", ref_file);
            return 2;
        }
        const size_t got = std::fread(want.data(), sizeof(float), want.size(), fp);
        std::fclose(fp);
        if (got != want.size()) {
            std::fprintf(stderr, "DS4_REF_FILE: %zu floats, expected %zu\n", got, want.size());
            return 2;
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        // Only the MV_N outputs the kernel actually writes. `n` has to cover the RAW BYTE
        // size of the weights, so it is far larger than the output and the tail of `c` is
        // whatever the allocation held.
        const size_t cmp = std::min(want.size(), static_cast<size_t>(MV_N));
        for (size_t i = 0; i < cmp; ++i) {
            const double d = std::fabs(static_cast<double>(c[i]) - static_cast<double>(want[i]));
            abs_sum += d;
            sum_ref += std::fabs(static_cast<double>(want[i]));
            if (d > max_abs) max_abs = d;
            // AGGREGATE, not per-element relative. The first version of this branch counted
            // an element "wrong" whenever d > tol*|want|, and 89 of 1024 tripped it on a
            // backward error of 1.4e-07: those are the outputs where the dot CANCELS and
            // |want| is ~0, which is precisely the metric this campaign retired for oracle 15.
            (void)d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%zu wrong=%d max_abs=%.3e backward_rel=%.3e\n", cmp, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
    if (ORACLE == 30) {
        // ELEMENTWISE exp on a fresh load: out[i] = exp(a[i]). The final discrimination on the
        // attention softmax -- `exp` over 8 elements returned NaN from a buffer that the previous
        // stage had certified, so this asks whether the OP or its SOURCE is at fault.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < MV_K; ++i) {
            const double want = std::exp(static_cast<double>(a[i]));
            const double got = static_cast<double>(c[i]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 29) {
        // ATTENTION STAGE 2d: exp(score) alone, 8 values. Isolates `exp` from `reduce_sum(1 x 8)`.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double want = std::exp(s);
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 28) {
        // ATTENTION STAGE 2c: sum of exp(score), no divide. One value out. Separates the
        // denominator (reduce_sum) and exp from the final division.
        const int S = MV_N, D = MV_K;
        double den = 0.0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            den += std::exp(s);
        }
        const double got = static_cast<double>(c[0]);
        const double diff = std::fabs(got - den);
        const double backward = diff / (std::fabs(den) > 1e-30 ? std::fabs(den) : 1.0);
        int bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=1 wrong=%d max_abs=%.3e backward_rel=%.3e\n", bad, diff, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 27) {
        // ATTENTION STAGE 2b: softmax WITHOUT the max shift. Identical to ORACLE 26 for bounded
        // inputs, and it exists to separate `reduce_max` from `exp`/`reduce_sum`/`div`: if the
        // kernel without a max-based `sub` passes, the 8-element reduce_max is the fault.
        const int S = MV_N, D = MV_K;
        static double sc[256];
        double den = 0.0;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = std::exp(s);
            den += sc[p];
        }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            const double want = sc[p] / den;
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 26) {
        // ATTENTION STAGE 2: the softmax weights alone. out[p] = exp(score[p]-max)/sum_p exp(...),
        // with score[p] = sum_d kv[p][d]*q[d] + sink[p].
        const int S = MV_N, D = MV_K;
        static double sc[256];
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = s;
            if (s > m) m = s;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { sc[p] = std::exp(sc[p] - m); den += sc[p]; }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            const double want = sc[p] / den;
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 25) {
        // ATTENTION STAGE 1b: the dot products WITHOUT the sink. out[p] = sum_d kv[p][d]*q[d].
        // Separates `mul`+`reduce_sum` from the sink load and add, which is the only way to say
        // which of them produces inf.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double want = 0.0;
            for (int d = 0; d < D; ++d)
                want += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double got = static_cast<double>(c[p]);
            const double diff = std::fabs(got - want);
            abs_sum += diff;
            sum_ref += std::fabs(want);
            if (diff > max_abs) max_abs = diff;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 24) {
        // ATTENTION STAGE 1: the scores only. out[p] = sum_d kv[p][d]*q[d] + sink[p], p < S.
        // This exists to bisect the attention kernel: when the whole thing faults, this says
        // whether the scores half is sound before the softmax and the weighted sum are added.
        const int S = MV_N, D = MV_K;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int p = 0; p < S; ++p) {
            double want = static_cast<double>(v[p]);
            for (int d = 0; d < D; ++d)
                want += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            const double got = static_cast<double>(c[p]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", S, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 23) {
        // ONE-HEAD SINK ATTENTION. a = q[512], b = kv[128][512], v = sink[8], out[512].
        //   score[p] = sum_d kv[p][d]*q[d] + sink[p % 8]      (sink added to every block)
        //   out[c]   = sum_p softmax(score)[p] * kv[p][c]     (K and V are the same tensor, as the
        //                                                      fixture's single %kv implies)
        const int S = MV_N, D = MV_K;  // MV_N positions (8 or 128), MV_K head width.
        static double sc[256], ew[256];
        double m = -1e300;
        for (int p = 0; p < S; ++p) {
            double s = static_cast<double>(v[p % 8]);
            for (int d = 0; d < D; ++d)
                s += static_cast<double>(b[p * D + d]) * static_cast<double>(a[d]);
            sc[p] = s;
            if (s > m) m = s;
        }
        double den = 0.0;
        for (int p = 0; p < S; ++p) { ew[p] = std::exp(sc[p] - m); den += ew[p]; }
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < D; ++col) {
            double want = 0.0;
            for (int p = 0; p < S; ++p) want += ew[p] * static_cast<double>(b[p * D + col]);
            want /= den;
            const double got = static_cast<double>(c[col]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", D, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 22) {
        // OFFSET LOAD: the kernel loads at element MV_N*MV_K, so out[i] must equal a[MV_N*MV_K + i].
        // Choosing the oracle's source window from the kernel's own offset keeps the check honest:
        // a kernel that ignored the offset and read element 0 would compare against the wrong window
        // and fail rather than silently agreeing.
        const int off = MV_N * MV_K;
        const int total = off;
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < total; ++i) {
            const double want = static_cast<double>(a[off + i]);
            const double got = static_cast<double>(c[i]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", total, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 21) {
        // ROW AXPY: out[c] = v[c] + a[0] * b[0][c] -- `acc += w[row]*src[row][:]` for row 0.
        // a = the weight column, b = the source tile, v = the accumulator to start from.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int col = 0; col < MV_K; ++col) {
            const double want = static_cast<double>(v[col]) + static_cast<double>(a[0]) * static_cast<double>(b[col]);
            const double got = static_cast<double>(c[col]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 19) {
        // ROW SCALE: out[r][c] = a[r] * b[r][c]. Anchored on the LIVE ORACLE 18 block, which is the
        // comparison section -- the previous oracle was placed in the init section by anchoring on
        // the first match of a name that appears twice, and it cost three rounds.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int r = 0; r < MV_N; ++r) {
            for (int col = 0; col < MV_K; ++col) {
                const double want = static_cast<double>(a[r]) * static_cast<double>(b[r * MV_K + col]);
                const double got = static_cast<double>(c[r * MV_K + col]);
                const double d = std::fabs(got - want);
                abs_sum += d;
                sum_ref += std::fabs(want);
                if (d > max_abs) max_abs = d;
            }
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_N * MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 18) {
        // BROADCAST: out[r][c] = a[c] -- the `col_expand` primitive. MV_N rows, MV_K wide.
        //
        // THIS BLOCK MUST SIT AFTER THE HOST COPY-BACK. An earlier version of it was inserted by
        // anchoring on the first `ORACLE == 17` in the file, which is in the INIT section -- so it
        // compared `c` before the kernel ran, returned early, and reported FAIL for every kernel
        // including a trivially correct identity one. Three rounds of "the broadcast returns zeros"
        // were this placement error and nothing else.
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int r = 0; r < MV_N; ++r) {
            for (int col = 0; col < MV_K; ++col) {
                const double want = static_cast<double>(a[col]);
                const double got = static_cast<double>(c[r * MV_K + col]);
                const double d = std::fabs(got - want);
                abs_sum += d;
                sum_ref += std::fabs(want);
                if (d > max_abs) max_abs = d;
            }
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_N * MV_K, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }

    if (ORACLE == 17) {
        // THE ENGINE'S q8mv SOCKET: out[r] = sum_k w8[r,k] * x[k] * s[r,k].
        // a = int8 weights (raw bytes), b = the PRE-EXPANDED f32 scale plane, v = activation.
        // This is the oracle the four `ds4_q8mv_*` slots need, and it exists because the earlier
        // mismatch was discovered by comparing SIGNATURES rather than shapes (iteration 51).
        const signed char *wq = reinterpret_cast<const signed char *>(a.data());
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int r = 0; r < MV_N; ++r) {
            double want = 0.0;
            for (int k = 0; k < MV_K; ++k) {
                const double term = static_cast<double>(wq[r * MV_K + k]) *
                                    static_cast<double>(v[k]) *
                                    static_cast<double>(b[r * MV_K + k]);
                want += term;
                abs_sum += std::fabs(term);
            }
            const double got = static_cast<double>(c[r]);
            const double d = std::fabs(got - want);
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", MV_N, bad, max_abs, backward);
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
    if (ORACLE == 16) {
        // RMS-norm TIMES GAMMA -- the engine's `ds4_rmsmul_W(x, g, o)`. Two inputs (a = x,
        // b = gamma) and one output. This oracle exists because the pure-rms_norm one let three
        // slots be credited by shape for thirty rounds: the engine's chain ends in tmul(out, g).
        double ss = 0.0;
        for (int i = 0; i < n; ++i) ss += static_cast<double>(a[i]) * static_cast<double>(a[i]);
        const double rms = std::sqrt(ss / static_cast<double>(n) + 1e-6);
        double abs_sum = 0.0, max_abs = 0.0, sum_ref = 0.0;
        int bad = 0;
        for (int i = 0; i < n; ++i) {
            const double want = (static_cast<double>(a[i]) / rms) * static_cast<double>(b[i]);
            const double got = static_cast<double>(c[i]);
            const double d = std::fabs(got - want);
            abs_sum += d;
            sum_ref += std::fabs(want);
            if (d > max_abs) max_abs = d;
        }
        const double backward = abs_sum / (sum_ref > 1e-30 ? sum_ref : 1.0);
        printf("elements=%d wrong=%d max_abs=%.3e backward_rel=%.3e\n", n, bad, max_abs, backward);
        bad = (backward <= static_cast<double>(TOLERANCE)) ? 0 : 1;
        printf("%s\n", bad == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return bad == 0 ? 0 : 2;
    }
    if (ORACLE == 12) {
        // rope over HALVES: the engine's `ds4_rope_halves`, whose chain is written out in
        // ptoas_rs/tests/fixtures/barrier/layer0.pto:364 --
        //   o[0..32)  = x_lo*cos - x_hi*sin
        //   o[32..64) = x_hi*cos + x_lo*sin
        // with x_lo = a[0..32), x_hi = a[32..64), cos = b[0..32), sin = v[0..32).
        const int half = n / 2;
        for (int i = 0; i < half; ++i) {
            const double xl = static_cast<double>(a[i]);
            const double xh = static_cast<double>(a[half + i]);
            const double co = static_cast<double>(b[i]);
            const double si = static_cast<double>(v[i]);
            const double want_lo = xl * co - xh * si;
            const double want_hi = xh * co + xl * si;
            const double got_lo = static_cast<double>(c[i]);
            const double got_hi = static_cast<double>(c[half + i]);
            for (int k = 0; k < 2; ++k) {
                const double want = (k == 0) ? want_lo : want_hi;
                const double got = (k == 0) ? got_lo : got_hi;
                const double d = std::fabs(got - want);
                const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
                if (d > max_abs) max_abs = d;
                if (d / ref > max_rel) max_rel = d / ref;
                if (d / ref > TOLERANCE) ++wrong;
            }
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 15) {
        // w8a8 dot: out[r] = sum_k x[k] * ((q[r,k] - off[r]) * sc[r]).
        const signed char *wq = reinterpret_cast<const signed char *>(b.data());
        for (int r = 0; r < MV_N; ++r) {
            double want = 0.0;
            // BACKWARD error, not |got-want|/|want|. With 256 terms of magnitude ~1e5 that
            // cancel, a near-zero result has no meaningful relative error in f32 -- the
            // first run reported 2.6e-05 "relative error" on three elements purely because
            // their |want| was small. Dividing by the sum of |terms| measures what f32 can
            // actually promise for a dot product: d <= eps * sum|terms|.
            double abs_sum = 0.0;
            for (int k = 0; k < MV_K; ++k) {
                const double term = static_cast<double>(a[k]) *
                                    ((static_cast<double>(wq[r * MV_K + k]) -
                                      static_cast<double>(s[r])) *
                                     static_cast<double>(v[r]));
                want += term;
                abs_sum += std::fabs(term);
            }
            const double got = static_cast<double>(c[r]);
            const double d = std::fabs(got - want);
            const double ref = abs_sum > 1e-30 ? abs_sum : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", MV_N, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 14) {
        // q8_0 dot: out[r] = sum_k x[k] * (qv * scale), scale 0.5 per 32-element block.
        const unsigned char *bytes = reinterpret_cast<const unsigned char *>(b.data());
        for (int r = 0; r < MV_N; ++r) {
            double want = 0.0;
            for (int blk = 0; blk < MV_K / 32; ++blk) {
                const unsigned char *p = bytes + ((size_t)r * (MV_K / 32) + blk) * 34;
                for (int q = 0; q < 32; ++q) {
                    const signed char qv = static_cast<signed char>(p[2 + q]);
                    want += static_cast<double>(a[blk * 32 + q]) *
                            (static_cast<double>(qv) * 0.5);
                }
            }
            const double got = static_cast<double>(c[r]);
            const double d = std::fabs(got - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", MV_N, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 13) {
        // Streaming matvec: out[j] = sum_k x[k] * W[j, k], with the weight row-major and
        // STREAMED a row at a time. x is `a`, W is `b`, out is `c`.
        // MV_N and MV_K are passed in the kernel's own extents; the harness allocates
        // `n` floats per buffer, so n must cover MV_N * MV_K.
        for (int j = 0; j < MV_N; ++j) {
            double want = 0.0;
            for (int k = 0; k < MV_K; ++k)
                want += static_cast<double>(a[k]) * static_cast<double>(b[j * MV_K + k]);
            const double got = static_cast<double>(c[j]);
            const double d = std::fabs(got - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", MV_N, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 11) {
        // 4-tap weighted sum over the eight inputs in call order:
        //   out = sum_j x_j * w_j,  x = (a, b, v, e), w = (f, g, h, s)
        for (int i = 0; i < n; ++i) {
            const double xs[4] = {static_cast<double>(a[i]), static_cast<double>(b[i]),
                                  static_cast<double>(v[i]), static_cast<double>(e[i])};
            const double ws[4] = {static_cast<double>(f[i]), static_cast<double>(g[i]),
                                  static_cast<double>(h[i]), static_cast<double>(s[i])};
            double want = 0.0;
            for (int j = 0; j < 4; ++j) want += xs[j] * ws[j];
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3);
        aclrtFree(p4); aclrtFree(p5); aclrtFree(p6); aclrtFree(p7); aclrtFree(p8);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 4) {
        // The delta-net at decode: o = decay*s + beta*(q.k)*v, with the
        // generator's own constants. `q.k` is one value spread over the row,
        // which is exactly the broadcast under test.
        const double decay = 0.5, beta = 1.0;
        double qk = 0.0;
        for (int j = 0; j < n; ++j) qk += static_cast<double>(a[j]) * static_cast<double>(b[j]);
        for (int i = 0; i < n; ++i) {
            const double want = decay * static_cast<double>(s[i]) + beta * qk * static_cast<double>(v[i]);
            const double d = std::fabs(static_cast<double>(c[i]) - want);
            const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
            if (d > max_abs) max_abs = d;
            if (d / ref > max_rel) max_rel = d / ref;
            if (d / ref > TOLERANCE) ++wrong;
        }
        printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
        printf("%s\n", wrong == 0 ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2); aclrtFree(p3); aclrtFree(p4);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return wrong == 0 ? 0 : 2;
    }
    if (ORACLE == 2) {
        // The emitted projection computes ONE output: y[0] = sum_j a[j]*b[j].
        // It then stores the whole tile, so everything past element 0 is a
        // buffer it never wrote. Count those separately: a kernel whose declared
        // extent exceeds what it defines is not covered by element 0 agreeing.
        double dot = 0.0;
        for (int j = 0; j < n; ++j) {
            dot += static_cast<double>(a[j]) * static_cast<double>(b[j]);
        }
        const double d0 = std::fabs(static_cast<double>(c[0]) - dot);
        const double ref0 = std::fabs(dot) > 1e-12 ? std::fabs(dot) : 1.0;
        int unwritten = 0;
        for (int i = 1; i < n; ++i) {
            if (c[i] != 0.0f) ++unwritten;
        }
        printf("declared=%d defined=1 undefined=%d dot=%0.9e got=%0.9e rel=%.3e\n",
               n, unwritten, dot, static_cast<double>(c[0]),
               d0 / ref0 + 0.5e-30 + 0.5e-30);
        printf("element0 %s\n", (d0 / ref0) <= TOLERANCE ? "PASS" : "FAIL");
        aclrtFree(p0); aclrtFree(p1); aclrtFree(p2);
        aclrtDestroyStream(stream); aclrtDestroyContext(ctx);
        CHECK(aclrtResetDevice(0)); aclFinalize();
        return (d0 / ref0) <= TOLERANCE ? 0 : 2;
    }
    for (int i = 0; i < n; ++i) {
        double want;
        if (ORACLE == 1) {
            want = a[i] / rms_denom;
        } else if (ORACLE == 3) {
            // silu(a) * b, the swiglu the corpus's gate/up kernel computes.
            want = (static_cast<double>(a[i]) /
                    (1.0 + std::exp(-static_cast<double>(a[i])))) *
                   static_cast<double>(b[i]);
        } else {
            want = static_cast<double>(a[i]) + static_cast<double>(b[i]);
        }
        const double d = std::fabs(static_cast<double>(c[i]) - want);
        if (d > max_abs) max_abs = d;
        const double ref = std::fabs(want) > 1e-12 ? std::fabs(want) : 1.0;
        if (d / ref > max_rel) max_rel = d / ref;
        if (d / ref > TOLERANCE) ++wrong;
    }
    printf("elements=%d wrong=%d max_abs=%.3e max_rel=%.3e\n", n, wrong, max_abs, max_rel);
    printf("%s\n", wrong == 0 ? "PASS" : "FAIL");

    aclrtFree(p0);
    aclrtFree(p1);
    aclrtFree(p2);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(ctx);
    CHECK(aclrtResetDevice(0));
    aclFinalize();
    return wrong == 0 ? 0 : 2;
}
